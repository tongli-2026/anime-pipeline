# ==============================================================
# Anime Pipeline — Environment Variables
# Copy to .env and fill in your API keys
# ==============================================================

# ── LLM (required) ──────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here

# ── Image Generation (at least one required) ────────────────
# OpenAI GPT Image 2 reuses OPENAI_API_KEY from the TTS section below.
# It is preferred for reference packs and keyframes; API billing is separate from ChatGPT.

# fal.ai — preferred for drafts and fallback generation
# Get key: https://fal.ai/dashboard/keys
FAL_KEY=

# Replicate — fallback
# Get key: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ── Video Generation (at least one for video scenes) ────────
# Optional dedicated fal.ai credential for Seedance; falls back to FAL_KEY.
SEEDANCE_API_KEY=

# SEEDANCE_API_KEY enables Seedance; FAL_KEY remains a compatible fallback.
# FAL_KEY also enables the Kling fallback.
# Seedance runs at 720p with generated audio disabled (~$0.13 per 5s clip).

# Runway Gen-3 — quality option ($0.05/sec)
# Get key: https://dev.runwayml.com/
RUNWAY_API_KEY=

# ── TTS / Voice (at least one for dialogue) ─────────────────
# OpenAI TTS — balanced ($0.015/1M chars)
# Get key: https://platform.openai.com/api-keys
# Also used for OpenAI image generation when the `openai` provider is selected.
OPENAI_API_KEY=

# ElevenLabs — best quality ($0.30/1M chars)
# Get key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Google Cloud TTS — cheapest ($0.004/1M chars)
# Get key: https://console.cloud.google.com/apis/credentials
GOOGLE_TTS_API_KEY=

# ── Optional: Local Services ────────────────────────────────
# ComfyUI (local image generation — free but requires GPU)
COMFYUI_BASE_URL=http://localhost:8188

# ── Optional: Task Queue ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Budget Defaults (USD) ───────────────────────────────────
BUDGET_HARD_LIMIT=5.0
BUDGET_WARN_AT=3.5
